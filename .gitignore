# The composite locality table is packaged source data, not runtime/test data;
# re-include it past the broad data/ rule above (S8 us_localities starter).
!src/decoy_engine/generation/composite/data/
!src/decoy_engine/generation/composite/data/us_localities.csv

# SP-06 / P5.INFRA.3: reference table Parquet files are packaged source data.
!src/decoy_engine/reference_tables/data/
!src/decoy_engine/reference_tables/data/us_zip5_city_state.parquet
!src/decoy_engine/reference_tables/data/vehicle_make_model_year.parquet

# Sphinx output: rendered HTML and autoapi-generated .rst (autoapi_keep_files
# is False, so docs/api is transient, but a failed build can leave it behind).
docs/_build/
docs/api/
.gstack/

# Dev scratch that must NEVER enter a source release. Agent worktrees are full
# nested repo snapshots (megabytes of duplicated docs + model packs); .hypothesis
# is the property-test DB. Both are untracked, but hatchling's default sdist sweep
# includes untracked files, so a `python -m build` from a dirty dev tree would
# otherwise upload them to PyPI (DE-07 hygiene). VCS-ignore is the root-cause fix
# (hatchling honors it); the sdist target also excludes them belt-and-suspenders.
.claude/worktrees/
.hypothesis/
