@@ -0,0 +1,46 @@
+"""The two places the platform builds the engine's mask-key provider.
+
+``instance_key_provider()`` keys real jobs and ``POST /unmask``: a 32-byte secret
+derived from the instance master key by HKDF-SHA256 with its own ``info`` label
+(RFC 5869 section 3.2 domain separation, as ``api/keys/derive.py`` already does
+for the pipeline keys and the public job seed), wrapped in the engine's
+``SecretKeyProvider``. ``ephemeral_preview_key_provider()`` keys previews: 32
+bytes from ``secrets`` per request, never persisted and never derived from the
+master, because a preview must not read the master key (``preview_parent.py``)
+and must not compute production keyed output for operator-chosen input.
+
+Neither caches: a master-key reset or restore cannot leave a stale provider. No
+local in either function binds key bytes, so a failing call's traceback carries
+none (``run_boxed`` is the failure boundary).
+"""
+
+from __future__ import annotations
+
+import secrets
+from collections.abc import Callable
+from typing import Any
+
+from api.keys.derive import derive_from_master
+from api.keys.mask_secret_errors import run_boxed
+
+# Distinct from every other info label under api/keys (pipeline:*, col:*,
+# v2-job-seed:mask:instance): the public job seed is never a prefix of this secret.
+_MASK_SECRET_INFO = "v2-mask-secret:instance"
+KEY_VERSION = "v1"
+
+
+def _provider(secret: Callable[[], bytes], key_version: str) -> Any:
+    from decoy_engine import SecretKeyProvider
+
+    # The engine constructor's own frame holds the secret argument, so it is boxed too.
+    return run_boxed(
+        lambda: SecretKeyProvider(secret(), key_version=key_version), "mask_key_derivation_failed"
+    )
+
+
+def instance_key_provider() -> Any:
+    return _provider(lambda: derive_from_master(_MASK_SECRET_INFO), KEY_VERSION)
+
+
+def ephemeral_preview_key_provider() -> Any:
+    return _provider(lambda: secrets.token_bytes(32), "preview")
