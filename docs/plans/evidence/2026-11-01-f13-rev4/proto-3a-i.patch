diff --git a/api/keys/mask_secret_errors.py b/api/keys/mask_secret_errors.py
new file mode 100644
index 0000000..631785f
--- /dev/null
+++ b/api/keys/mask_secret_errors.py
@@ -0,0 +1,61 @@
+"""Platform-local registry of mask-secret failure codes.
+
+Pattern: a typed error plus a frozen code set, as ``api/seeds/secrets.py``
+(``SEED_ERROR_CODES``). Every message is a constant: none formats a length, path,
+provider name, environment value or exception text, so a log line, ``Job.log``,
+error node or HTTP body built from one carries no value. Not engine reasons: the
+platform owns these codes.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from types import MappingProxyType
+from typing import TypeVar
+
+_T = TypeVar("_T")
+
+MESSAGES: Mapping[str, str] = MappingProxyType(
+    {
+        "master_key_invalid": "The instance master key is not a valid 32-byte key.",
+        "master_key_unavailable": "The instance master key could not be read.",
+        "kms_misconfigured": "The KMS master-key provider is not configured correctly.",
+        "kms_dependency_missing": "The KMS client library for the selected provider is not installed.",
+        "kms_unavailable": "The KMS-wrapped master key could not be unwrapped.",
+        "mask_key_derivation_failed": "The masking key could not be derived from the master key.",
+        "mask_secret_ref_not_allowed": (
+            "global_settings.mask_secret_ref is not allowed in a platform job; the platform "
+            "keys masking from its instance master key."
+        ),
+    }
+)
+MASK_SECRET_ERROR_CODES = frozenset(MESSAGES)
+
+
+class MaskSecretConfigError(ValueError):
+    """A platform mask-secret failure: a registered ``code`` and its constant text only."""
+
+    def __init__(self, code: str) -> None:
+        self.code = code if code in MESSAGES else "mask_key_derivation_failed"
+        self.message = MESSAGES[self.code]
+        super().__init__(self.message)
+
+
+class MasterKeyError(MaskSecretConfigError):
+    """The master key failed to load. A ``ValueError``, so existing handlers still match."""
+
+
+def run_boxed(work: Callable[[], _T], code: str) -> _T:
+    """``work()``, or ``MaskSecretConfigError(code)`` raised from this frame after the handler.
+
+    Raised outside the ``except`` so it has no ``__cause__`` or ``__context__`` and its
+    traceback holds none of the failing frames, whose locals can hold key material.
+    A platform mask-secret error passes through: it was raised from a key-free frame.
+    """
+    try:
+        return work()
+    except MaskSecretConfigError:
+        raise
+    except Exception:
+        pass
+    raise MaskSecretConfigError(code)
