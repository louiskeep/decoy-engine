index 0000000..59bdfeb
--- /dev/null
+++ b/src/decoy/_mask_secret.py
@@ -0,0 +1,57 @@
+"""The one mask-secret path every CLI surface shares.
+
+Ref shape (`env:NAME` / `file:/PATH`), flag injection (`--mask-secret` or `mask_secret=`
+fills the same `global_settings.mask_secret_ref` slot the YAML can set; both set is a usage
+error, keyed on presence), one admission per command (the engine's `AdmissionScope`, closed
+on every exit, so a run and its vault see one read of the secret), and the error text a
+secret failure prints. Callers pass their own wording, so each surface's text is unchanged.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+from contextlib import contextmanager
+from typing import Any
+
+
+class MaskSecretFlagError(Exception):
+    """A usage error from `apply_mask_secret` on a surface with no error type of its own."""
+
+
+BOTH_SET = (
+    "--mask-secret was passed but the YAML already sets global_settings.mask_secret_ref. "
+    "Set the masking secret in exactly one place: drop --mask-secret, or remove "
+    "mask_secret_ref from the config."
+)
+INVALID = (
+    "Invalid mask secret: expected an 'env:NAME' or 'file:/PATH' reference to a >=32-byte "
+    "secret (from --mask-secret or global_settings.mask_secret_ref). It is a REFERENCE, "
+    "never the raw secret. See: decoy explain keys."
+)
+
+
+def is_valid_mask_secret_ref(value: object) -> bool:
+    return isinstance(value, str) and value.startswith(("env:", "file:"))
+
+
+def apply_mask_secret(
+    config_dict: dict, flag: str | None, *, error: type[Exception], both_set: str, invalid: str
+) -> None:
+    """Inject `flag`, then check the effective ref. Never echoes a value."""
+    if flag is not None:
+        if (config_dict.get("global_settings") or {}).get("mask_secret_ref") is not None:
+            raise error(both_set)
+        config_dict.setdefault("global_settings", {})["mask_secret_ref"] = flag
+    ref = (config_dict.get("global_settings") or {}).get("mask_secret_ref")
+    if ref is not None and not is_valid_mask_secret_ref(ref):
+        raise error(invalid)
+
+
+@contextmanager
+def admitted_key_provider(config_dict: dict) -> Iterator[Any]:
+    """The command's one admitted provider (None when nothing is keyed and no ref is set)."""
+    from decoy_engine.secret_providers import AdmissionScope, admit_mask_key
+
+    with AdmissionScope() as scope:
+        yield scope.adopt(admit_mask_key(config_dict)).key_provider
+
