diff --git a/api/pipelines/mask_secret_guard.py b/api/pipelines/mask_secret_guard.py
new file mode 100644
index 0000000..49654e8
--- /dev/null
+++ b/api/pipelines/mask_secret_guard.py
@@ -0,0 +1,22 @@
+"""Platform job configs may not name a mask-secret reference.
+
+The platform keys masking from its instance master key (``api/jobs/engine_key.py``);
+a ``global_settings.mask_secret_ref`` in a job config would let its author choose a
+host environment variable or file for the server to read. Presence-based: ``None``
+is allowed, anything else (``""`` included) is refused with a constant message that
+never echoes the value. FastAPI-free and non-mutating, like ``config_guard.py``.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from api.keys.mask_secret_errors import MaskSecretConfigError
+
+CODE = "mask_secret_ref_not_allowed"
+
+
+def reject_mask_secret_ref(config: Any) -> None:
+    settings = config.get("global_settings") if isinstance(config, dict) else None
+    if isinstance(settings, dict) and settings.get("mask_secret_ref") is not None:
+        raise MaskSecretConfigError(CODE)
