     with AdmissionScope() as scope:
         yield scope.adopt(admit_mask_key(config_dict)).key_provider
 
+
+def mask_secret_error_text(exc: BaseException, keyed_remedy: str) -> str:
+    """`code: engine text` for a secret failure, or the surface's remedy for the keyed refusal.
+    Reads only the registered code and the engine's constant message, never `str(exc)`."""
+    from decoy import _mask_secret_guidance
+
+    if _mask_secret_guidance.is_keyed_secret_refusal(exc):
+        return keyed_remedy
+    message = getattr(exc, "message", None)
+    return f"{getattr(exc, 'code', type(exc).__name__)}: {message if isinstance(message, str) else ''}"
