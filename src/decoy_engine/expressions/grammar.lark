// Closed-vocabulary expression grammar for decoy_engine derived / case_when
// strategies (SP-06 / P5.INFRA.2).
//
// SECURITY CONTRACT: only the listed operators / forms are valid. Any
// attempt to use function calls (other than concat and days_between),
// attribute access, subscript syntax, import, or dunder identifiers
// produces a parse error -> ValidationError. This is the primary
// security boundary for config-supplied expressions.
//
// Operator set:
//   Arithmetic: + - * / //
//   Comparison: == != < > <= >= in
//   Logical:    and or not
//   String:     concat(a, b)
//   Date:       days_between(start, end)
//   Ternary:    value if condition else other
//   Literals:   integers, floats, strings, True, False, None
//   Refs:       identifier (column name - no dots, no dunders)

start: expr

expr: ternary

ternary: or_expr
       | or_expr "if" or_expr "else" ternary

or_expr: and_expr ("or" and_expr)*

and_expr: not_expr ("and" not_expr)*

not_expr: "not" not_expr  -> not_op
        | compare_expr

compare_expr: add_expr (CMP_OP add_expr)*

CMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">" | "in"

add_expr: mul_expr (ADD_OP mul_expr)*
ADD_OP: "+" | "-"

mul_expr: unary_expr (MUL_OP unary_expr)*
MUL_OP: "//" | "*" | "/"

unary_expr: "-" unary_expr  -> neg_op
          | primary

primary: "concat" "(" expr "," expr ")"    -> concat_op
       | "days_between" "(" expr "," expr ")"  -> days_between_op
       | "(" expr ")"                          -> paren_expr
       | "[" "]"                               -> empty_list
       | "[" expr ("," expr)* "]"             -> list_literal
       | NUMBER                                -> number_lit
       | ESCAPED_STRING                        -> string_lit
       | "True"                                -> true_lit
       | "False"                               -> false_lit
       | "None"                                -> none_lit
       | IDENTIFIER                            -> col_ref

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/

%import common.ESCAPED_STRING
%import common.WS
%ignore WS
